# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4
# Based on https://github.com/nikitabobko/homebrew-tap/blob/64d46a5546d3fe6f7ab368f5a3df0984adfe7087/Casks/aerospace.rb
PortSystem              1.0
PortGroup               github 1.0

github.setup            nikitabobko AeroSpace 0.16.2-Beta v
github.tarball_from     releases
distname                ${github.project}-v${github.version}

use_zip                 yes
use_configure           no
build                   {}

set pkg_workpath        ${workpath}/${github.project}-v${github.version}

destroot {
  file copy ${pkg_workpath}/AeroSpace.app ${destroot}/Applications/MacPorts/AeroSpace.app
  xinstall -m 0755 ${pkg_workpath}/bin/aerospace ${destroot}${prefix}/bin

  xinstall -d -m 0755 ${destroot}${prefix}/share/zsh/site-functions
  xinstall -d -m 0755 ${destroot}${prefix}/share/bash-completion/completions
  xinstall -d -m 0755 ${destroot}${prefix}/share/fish/vendor_completions.d

  xinstall -m 0755 ${pkg_workpath}/shell-completion/zsh/_aerospace ${destroot}${prefix}/share/zsh/site-functions/_aerospace
  xinstall -m 0755 ${pkg_workpath}/shell-completion/bash/aerospace ${destroot}${prefix}/share/bash-completion/completions/aerospace
  xinstall -m 0755 ${pkg_workpath}/shell-completion/fish/aerospace.fish ${destroot}${prefix}/share/fish/vendor_completions.d/aerospace.fish
  #xinstall -m 0755 {*}[glob ${pkg_workpath}/manpage/*.1] ${destroot}${prefix}/man/man1
}

post-destroot {
  fs-traverse fixfile ${destroot} {
    if {[exec xattr -l ${fixfile}] != ""} {
      system "xattr -d com.apple.quarantine ${fixfile}"
    }
  } 
}

categories              sysutils
maintainers             {@TheKevJames thekev.in:macports} openmaintainer
license                 MIT
description             AeroSpace is an i3-like tiling window manager for macOS

checksums               rmd160  ae236a9a987a410885220edd0b86aece42d0fe64 \
                        sha256  1e26c4dc67110168fcb04000caf91904b94e42f453451726ad6000aef7e4340f \
                        size    8025877  
